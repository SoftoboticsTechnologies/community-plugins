# Copy this file to .env in this directory and fill in your Cashfree sandbox credentials before
# running the dev server. These values are used by the dev-server script to configure the Cashfree
# PaymentMethod's handler arguments (Client ID / Client Secret are set per-PaymentMethod via the
# Admin UI, not CashfreePlugin.init()).

# Cashfree Client ID (x-client-id), from the Cashfree Merchant Dashboard
CASHFREE_CLIENT_ID=

# Cashfree Client Secret (x-client-secret), from the Cashfree Merchant Dashboard. Also used to
# verify webhook signatures - Cashfree does not use a separate webhook signing secret.
CASHFREE_CLIENT_SECRET=
