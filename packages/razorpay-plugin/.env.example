# Copy this file to .env in this directory and fill in your Razorpay test credentials
# before running the dev server (yarn start / npm run dev). These values are used by the
# dev-server script to configure the Razorpay PaymentMethod's handler arguments (Key ID /
# Key Secret / Webhook Secret are set per-PaymentMethod via the Admin UI, not RazorpayPlugin.init()).

# Razorpay Key ID, from the Razorpay dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=

# Razorpay Key Secret, from the Razorpay dashboard (Settings -> API Keys)
RAZORPAY_KEY_SECRET=

# Webhook signing secret configured in the Razorpay dashboard (Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=
