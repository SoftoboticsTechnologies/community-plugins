# Copy this file to .env in this directory and fill in your Shiprocket sandbox/account
# credentials before running the dev server (npm run dev-server). These values are used to seed
# the calculator arguments of the ShippingMethod the dev server creates - in a real deployment,
# these are entered directly on a ShippingMethod's "Shiprocket live shipping rate" calculator in
# the Admin UI (or via the API), not passed to ShiprocketPlugin.init().

# Email address used to authenticate with the Shiprocket API
SHIPROCKET_EMAIL=

# Password used to authenticate with the Shiprocket API
SHIPROCKET_PASSWORD=

# Nickname of the pickup address configured in your Shiprocket account (Settings > Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=

# Numeric sales-channel ID registered in your Shiprocket account (Settings > API > Channel options)
SHIPROCKET_CHANNEL_ID=

# Postcode of the pickup address above, used as the origin for live serviceability/rate checks
SHIPROCKET_PICKUP_POSTCODE=
