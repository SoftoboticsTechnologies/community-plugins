{
    "name": "@softobotics/vendure-product-import",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "description": "Import Vendure products from a native CSV, a Shopify products_export.csv, or the Shopify Admin API — with pre-import validation and per-row error reporting.",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*"
    ],
    "private": false,
    "keywords": [
        "vendure",
        "plugin",
        "import",
        "csv",
        "shopify",
        "products"
    ],
    "scripts": {
        "watch": "tsc -p ./tsconfig.build.json --watch",
        "build": "rimraf lib && tsc -p ./tsconfig.build.json && copyfiles -u 1 \"src/dashboard/**/*\" \"src/email-templates/**/*\" lib/",
        "e2e": "cross-env PACKAGE=vendure-product-import vitest --config ../../e2e-common/vitest.config.mts --run",
        "e2e:watch": "cross-env PACKAGE=vendure-product-import vitest --config ../../e2e-common/vitest.config.mts",
        "test": "vitest run",
        "lint": "eslint .",
        "ci": "npm run build"
    },
    "homepage": "https://www.vendure.io/",
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@vendure/common": "^3.6.0-0",
        "@vendure/core": "^3.6.0-0",
        "@vendure/email-plugin": "^3.6.0-0"
    },
    "peerDependenciesMeta": {
        "@vendure/email-plugin": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/multer": "^1.4.13",
        "@vendure/common": "3.6.0-minor-202603280303",
        "@vendure/core": "3.6.0-minor-202603280303",
        "@vendure/dashboard": "3.6.0-minor-202603280303",
        "@vendure/email-plugin": "^3.6.0-minor-202603280303",
        "@vendure/testing": "3.6.0-minor-202603280303",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "rimraf": "^5.0.5",
        "typescript": "5.8.2",
        "vitest": "^3.0.0"
    }
}
